# Frontend environment (build-time). Copy to .env / .env.production.
# Local dev: leave blank to use the Vite proxy at /api.
# Production (Render): set to your Render API origin including /api,
#   e.g. VITE_API_URL=https://luma-api.onrender.com/api
# On Render static site, VITE_API_URL=/api uses the rewrite proxy.
VITE_API_URL=

# AI Fallback: Puter.js AI is available as a client-side fallback when
# backend AI is not configured. No API keys needed - it's free!
# The Puter.js script is loaded in index.html automatically.
