FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
DATABASE_URL=sqlite:///wemaone.db
CORS_ORIGINS=http://localhost:5173

# AI / LLM (free tiers — no cost required)
# AI_PROVIDER = groq | gemini | mock   (mock = deterministic, offline, never paid)
AI_ENABLED=false
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ALAT Authenticator (Pay with Bank Account) — WEMA developer portal
ALAT_SANDBOX=true
ALAT_BASE_URL=https://sandbox-api.wemabank.com/alat/authenticator
ALAT_CLIENT_ID=
ALAT_CLIENT_SECRET=
ALAT_CALLBACK_URL=

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216