FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
# PostgreSQL in production. SQLite is the local fallback if left blank.
# On Render, if DATABASE_URL is not provided, SQLite is used automatically.
DATABASE_URL=postgresql://user:password@host:5432/nqb
# SEED_DATA: 1 = seed demo data on first boot, 0 = never seed
SEED_DATA=0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AI / LLM (free tiers — no cost required)
# AI_PROVIDER = groq | gemini | mock   (mock = deterministic, offline, never paid)
# Frontend also has Puter.js AI fallback when backend AI is not configured.
AI_ENABLED=false
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ALAT Authenticator (Pay with Bank Account) — WEMA developer portal
# Primary payment provider. If not configured, Paystack is used as fallback.
ALAT_SANDBOX=true
ALAT_BASE_URL=https://sandbox-api.wemabank.com/alat/authenticator
ALAT_CLIENT_ID=
ALAT_CLIENT_SECRET=
ALAT_CALLBACK_URL=

# Paystack fallback (used when ALAT is not configured)
# Get your keys at https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216